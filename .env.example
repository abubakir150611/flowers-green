# PostgreSQL connection strings.
# DIRECT_URL is used for migrations when DATABASE_URL points at a connection
# pooler (e.g. PgBouncer, Prisma Accelerate, Supabase pooler). If you connect
# directly to Postgres, both can be the same value.
DATABASE_URL="postgresql://user:password@localhost:5432/flowersgreen"
DIRECT_URL="postgresql://user:password@localhost:5432/flowersgreen"

# Secret used to sign admin session JWTs. Generate a strong random value, e.g.:
#   openssl rand -base64 32
AUTH_SECRET="change-me-to-a-long-random-string"

# Used once by `npm run db:seed` to create the first admin account.
# Change the password afterwards — there is no way to recover it from the
# codebase, it is hashed with bcrypt before being stored.
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="change-me-strong-password"

# Public URL of the deployed site (no trailing slash). Used for metadata,
# sitemap.xml, and links embedded in push notification payloads.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Web Push (VAPID) keys. Generate a pair with:
#   npx web-push generate-vapid-keys
# VAPID_PUBLIC_KEY must be duplicated into NEXT_PUBLIC_VAPID_PUBLIC_KEY so the
# admin browser can use it when subscribing (public value only, safe to expose).
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:admin@example.com"
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
